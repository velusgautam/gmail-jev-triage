# Get a key at https://beatapi.io/dashboard/apikeys
BEATAPI_API_KEY=your-key-here

# jev-1.13 is the paid model, jev-1.13-free is the free one
JEV_MODEL=jev-1.13

# How many emails to classify at the same time
CONCURRENCY=5
# Minimum gap between requests, in milliseconds (0 = no limit)
REQUEST_DELAY_MS=0

# Free tier? Use these instead:
#   JEV_MODEL=jev-1.13-free
#   CONCURRENCY=1
#   REQUEST_DELAY_MS=61000

LABEL_PREFIX=AI
GMAIL_QUERY=in:inbox -is:important
MAX_MESSAGES=100
